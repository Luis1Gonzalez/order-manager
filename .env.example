# Base de datos PostgreSQL en Supabase
# Supabase > tu proyecto > botón "Connect" > ORMs > Prisma
# Conexión con pooler (Transaction, puerto 6543): la usa la app
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (Session, puerto 5432): la usan las migraciones
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secreto para firmar las sesiones (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""

# Administrador inicial (lo crea `npm run db:seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Cloudinary (subida de imágenes de publicaciones)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
